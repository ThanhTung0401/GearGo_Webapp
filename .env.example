# GearGo — File cấu hình biến môi trường mẫu (TUYỆT ĐỐI KHÔNG commit giá trị thật / secret)
# Sao chép thành .env hoặc set trên Render / Docker / User Secrets

# ── Cơ sở dữ liệu ──
DatabaseProvider=SqlServer
ConnectionStrings__DefaultConnection=Server=localhost,11433;Database=GearGoDb;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=geargo;Username=postgres;Password=CHANGE_ME

# ── Bảo mật JWT ──
Jwt__SecretKey=CHANGE_ME_AT_LEAST_32_CHARS_SECRET_KEY
FrontendUrl=http://localhost:8443

# ── Tư vấn AI: n8n self-host + Gemini (Provider: Mock | Gemini | N8n | OpenAI) ──
TuVanOptions__Provider=N8n
TuVanOptions__ApiKey=
TuVanOptions__Model=gemini-2.5-flash
TuVanOptions__TimeoutSeconds=15
TuVanOptions__N8nWebhookUrl=http://localhost:5678/webhook/geargo-tu-van-thiet-bi
TuVanOptions__N8nApiKey=

# ── Email (Ưu tiên SendGrid -> SMTP -> LocalDev) ──
SendGrid__ApiKey=
SendGrid__FromEmail=no-reply@geargo.vn
SendGrid__FromName=GearGo Outdoor Equipment

EmailSettings__SmtpServer=
EmailSettings__Port=587
EmailSettings__SenderEmail=no-reply@geargo.vn
EmailSettings__SenderPassword=
EmailSettings__EnableSsl=true

# ── Thanh toán VNPay Sandbox (dự phòng tương lai) ──
VNPay__TmnCode=
VNPay__HashSecret=
VNPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__ReturnUrl=http://localhost:5000/api/thanh-toan/vnpay-return
VNPay__IpnUrl=http://localhost:5000/api/thanh-toan/vnpay-ipn

# VNPay Sandbox (v2.1.0)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_FRONTEND_URL=http://localhost:8443
