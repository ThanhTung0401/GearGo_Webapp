<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — GearGo" : "GearGo — Thuê đồ cắm trại")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "GearGo — Cho thuê lều, bàn ghế, đèn, bếp và phụ kiện cắm trại, du lịch.")" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

    @await Html.PartialAsync("_Header")

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-0 rounded-0 border-0" role="alert">
            <div class="container">@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-0 border-0" role="alert">
            <div class="container">@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-dark text-secondary py-4 mt-auto">
        <div class="container">
            <div class="row g-3">
                <div class="col-md-4">
                    <h6 class="text-white fw-bold">⛺ GearGo</h6>
                    <p class="small mb-0">Cho thuê lều, bàn ghế, đèn, bếp và phụ kiện cắm trại, du lịch.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white small fw-semibold">Liên kết</h6>
                    <ul class="list-unstyled small mb-0">
                        <li><a class="text-secondary text-decoration-none"
                               asp-controller="SanPham" asp-action="Index">Sản phẩm</a></li>
                        <li><a class="text-secondary text-decoration-none"
                               asp-controller="TuVan" asp-action="Index">Tư vấn AI</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="small mb-0">© @DateTime.Now.Year GearGo</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmtcEFyHCP+hk4w3QNTZ8SlUWmVTj0G"
            crossorigin="anonymous"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
